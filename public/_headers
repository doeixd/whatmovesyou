# Cloudflare Pages headers.
#
# The site is static and ships no third-party anything, so the policy can be
# genuinely strict rather than nominally strict.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; manifest-src 'self'

# Hashed by Vite — safe to cache forever.
/assets/assessment-*
  Cache-Control: public, max-age=31536000, immutable

# Stable filenames, so revalidate but allow a long stale window.
/assets/site.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
